# ─── Supabase ──────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── NestJS services ───────────────────────────────────────────────────────
# Defaults to localhost — override for deployed environments. Use the canonical
# ports from CLAUDE.md (venue 4003, customer/people 4004, booking 4005, etc.).
NEXT_PUBLIC_VENUE_SERVICE_URL=http://127.0.0.1:4003
NEXT_PUBLIC_CUSTOMER_SERVICE_URL=http://127.0.0.1:4004
NEXT_PUBLIC_BOOKING_SERVICE_URL=http://127.0.0.1:4005
NEXT_PUBLIC_COACHING_SERVICE_URL=http://127.0.0.1:4007
NEXT_PUBLIC_COMPETITION_SERVICE_URL=http://127.0.0.1:4009
NEXT_PUBLIC_TEAM_SERVICE_URL=http://127.0.0.1:4008
NEXT_PUBLIC_MEMBERSHIP_SERVICE_URL=http://127.0.0.1:4010

# ─── AI assistant (support chatbot) ─────────────────────────────────────────
# Anthropic API key for the in-portal AI assistant (/api/support/chat).
# MUST be a key from the ClubSpark Anthropic API organization — NOT a personal
# key. See docs/agentic-engineering.md → "AI features & API keys".
ANTHROPIC_API_KEY=sk-ant-...
