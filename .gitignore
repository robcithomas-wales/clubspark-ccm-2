# Claude Code — shared team config is committed (CLAUDE.md, .claude/settings.json,
# .claude/commands, .claude/agents). Only machine-local / secret bits are ignored.
.claude/settings.local.json
.claude/*.local.json
.claude/local/

# Dependencies
node_modules/

# Build output
dist/
.next/
out/
*.tsbuildinfo

# Test artifacts
test-results/
playwright-report/
.pytest_cache/

# Environment files — never commit secrets
.env
.env.local
.env.*.local
# Per-service escape hatch, applied on top of the generated .env
.env.override
.projection-backfill-state.json

# Editor/tool backups. `.env` is ignored but `.env.bak` was not, so any tool or
# script that saved a backup put the live database password one `git add -A`
# away from being committed.
*.bak
*.orig

# Keep examples committed
!.env.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Database dumps
*.dump
*.sql.gz

# Coverage
coverage/

# Prisma generated client (generated on install)
**/prisma/generated/
**/src/generated/
