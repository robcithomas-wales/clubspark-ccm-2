# Claude Code — shared team config is committed (CLAUDE.md, .claude/settings.json,
# .claude/commands, .claude/agents). Only machine-local / secret bits are ignored.
.claude/settings.local.json
.claude/*.local.json
.claude/local/

# Dependencies
node_modules/

# Build output
dist/
.next/
out/
*.tsbuildinfo

# Test artifacts
test-results/
playwright-report/
.pytest_cache/

# Environment files — never commit secrets
.env
.env.local
.env.*.local

# Keep examples committed
!.env.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Database dumps
*.dump
*.sql.gz

# Coverage
coverage/

# Prisma generated client (generated on install)
**/prisma/generated/
**/src/generated/
