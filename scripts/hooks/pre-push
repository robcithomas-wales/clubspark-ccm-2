#!/bin/sh
#
# Shared pre-push hook — committed, so every clone gets it.
# Installed by the root `prepare` script (npm install points core.hooksPath here).
#
# WHAT THIS IS FOR
#
# Fast, deterministic local feedback. It deliberately does NOT run the integration
# suites. CI is the gate that does: it builds the whole schema from empty on a
# throwaway Postgres, runs every service suite against it, checks drift, and lints
# changed files.
#
# WHY NO TESTS HERE
#
# The suites need a real database, and locally that is the shared Supabase
# instance. Running several suites back-to-back against it is unreliable for two
# reasons that have nothing to do with the code under test:
#
#   - they share one pgbouncer connection limit, so later suites fail with
#     "Can't reach database" or hook timeouts;
#   - they share fixture rows under fixed tenant ids, so a killed run leaves
#     orphans that make the next run fail.
#
# We hit both repeatedly. A hook that fails for environmental reasons is worse
# than no hook: it takes 20+ minutes and teaches people to reach for --no-verify,
# which then skips the checks that DO work. So this hook runs only what is fast
# and deterministic, and CI — which gets a clean, private Postgres every run —
# does the real verification.
#
# To run the suites locally against a clean database, see
# docs/engineering/database-migrations.md (migrate:all against a local Postgres).
#
# Skip in an emergency with: git push --no-verify
#
set -u

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

echo "→ Typechecking all services..."
if ! npm run typecheck --silent; then
  echo ""
  echo "✗ Push blocked — typecheck failed."
  echo "  Override (use sparingly): git push --no-verify"
  exit 1
fi

# Lint exactly what CI lints: the TypeScript files this push changes. Keeps the
# two in step, so a green hook means a green lint job.
UPSTREAM="$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || echo 'origin/main')"
echo "→ Linting changed files..."
if ! git diff -z --name-only --diff-filter=ACMR "$UPSTREAM"...HEAD -- '*.ts' '*.tsx' 2>/dev/null \
     | grep -zv -E '(generated|dist|node_modules)/' \
     | xargs -0 -r npx eslint; then
  echo ""
  echo "✗ Push blocked — lint failed on changed files."
  echo "  Fix with: npx eslint <files> --fix"
  echo "  Override (use sparingly): git push --no-verify"
  exit 1
fi

echo "✓ Typecheck and lint passed. CI will run the full suites against a clean database."
