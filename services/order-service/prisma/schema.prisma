// ClubSpark — Order Service Prisma Schema
// Owns the commerce schema: orders, order_items
//
// Every transaction on the platform must create an Order. This is the single
// shared commerce layer — revenue logic must not be reimplemented per module.
// Payment processing stays in payment-service; this service owns the transaction
// record and line-item breakdown.

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["commerce"]
}

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  organisationId String?     @map("organisation_id") @db.Uuid
  personId       String?     @map("person_id") @db.Uuid
  status         OrderStatus @default(pending)
  currency       String      @default("GBP") @db.Char(3)
  totalAmount    Int         @map("total_amount")
  subjectType    String?     @map("subject_type")
  subjectId      String?     @map("subject_id") @db.Uuid
  idempotencyKey String?     @unique @map("idempotency_key")
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items          OrderItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, personId])
  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, organisationId])
  @@map("orders")
  @@schema("commerce")
}

model OrderItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  productType String   @map("product_type")
  productId   String?  @map("product_id") @db.Uuid
  description String
  unitAmount  Int      @map("unit_amount")
  quantity    Int      @default(1)
  totalAmount Int      @map("total_amount")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([tenantId])
  @@index([tenantId, productType, productId])
  @@map("order_items")
  @@schema("commerce")
}

model Product {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  organisationId String?     @map("organisation_id") @db.Uuid
  name           String
  description    String?
  productType    String      @map("product_type")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderItems     OrderItem[]
  prices         Price[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, productType])
  @@map("products")
  @@schema("commerce")
}

model Price {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("GBP") @db.Char(3)
  memberAmount Decimal? @map("member_amount") @db.Decimal(10, 2)
  priceType    String   @default("standard") @map("price_type")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("prices")
  @@schema("commerce")
}

model EventOutbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([publishedAt, nextAttemptAt], map: "event_outbox_pending_idx")
  @@index([tenantId, createdAt], map: "event_outbox_tenant_idx")
  @@map("event_outbox")
  @@schema("commerce")
}

enum OrderStatus {
  pending
  confirmed
  cancelled
  refunded

  @@schema("commerce")
}
