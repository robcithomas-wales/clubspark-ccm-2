PORT=4004
NODE_ENV=development

# Primary database (write)
DATABASE_URL=postgresql://user:password@localhost:5432/clubspark

# Read replica (optional — falls back to DATABASE_URL)
DATABASE_READ_URL=

# Base URLs of the services people-service calls (customer merge, financial profile)
BOOKING_SERVICE_URL=http://localhost:4005
MEMBERSHIP_SERVICE_URL=http://localhost:4010

# Shared secret sent as X-Internal-Secret on service-to-service calls.
# The receiving guards in booking-service and membership-service fail closed when
# it is unset, so a customer merge will be rejected without it.
#
# The value below is a shared DEV default so a fresh checkout works out of the box.
# Every service must use the SAME value. Replace it in staging/production with:
#   openssl rand -hex 32
INTERNAL_SECRET=dev-internal-secret-change-in-production
