PORT=4004
NODE_ENV=development

# Primary database (write)
DATABASE_URL=postgresql://user:password@localhost:5432/clubspark

# Session-mode connection used ONLY by prisma migrate/introspect.
# Supabase: same credentials, port 5432 (NOT the 6543 transaction pooler, which
# hangs on DDL). Local Postgres: same value as DATABASE_URL.
DIRECT_DATABASE_URL=

# Read replica (optional — falls back to DATABASE_URL)
DATABASE_READ_URL=

# Base URLs of the services people-service calls (customer merge, financial profile)
BOOKING_SERVICE_URL=http://localhost:4005
MEMBERSHIP_SERVICE_URL=http://localhost:4010

# Shared secret sent as X-Internal-Secret on service-to-service calls.
# The receiving guards in booking-service and membership-service fail closed when
# it is unset, so a customer merge will be rejected without it.
#
# The value below is a shared DEV default so a fresh checkout works out of the box.
# Every service must use the SAME value. Replace it in staging/production with:
#   openssl rand -hex 32
INTERNAL_SECRET=dev-internal-secret-change-in-production

# Supabase project — JWTs are verified against its JWKS endpoint.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The region this service instance serves, e.g. eu-west-2.
# Required with no default: a service that does not know its own region cannot
# refuse a tenant whose data must stay elsewhere, and data residency is a legal
# boundary. An unset value stops the service at startup, which is the safe way
# to be wrong.
CLUBSPARK_REGION=eu-west-2
