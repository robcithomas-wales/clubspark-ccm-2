// ClubSpark — People Service Prisma Schema
// Owns the people schema: persons, lifecycle_history, tags, person_tags, person_roles, households, person_relationships

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["people"]
}

model Customer {
  id                   String               @id(map: "customers_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  firstName            String?              @map("first_name")
  lastName             String?              @map("last_name")
  email                String?
  phone                String?
  createdAt            DateTime             @default(now()) @map("created_at")
  marketingConsent     Boolean              @default(false) @map("marketing_consent")
  consentRecordedAt    DateTime?            @map("consent_recorded_at") @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lifecycleState       String               @default("active") @map("lifecycle_state")
  lifecycleChangedAt   DateTime?            @map("lifecycle_changed_at") @db.Timestamptz(6)
  source               String?              @default("admin")
  dateOfBirth          DateTime?            @map("date_of_birth") @db.Date
  avatarUrl            String?              @map("avatar_url")
  commsPreferences     Json                 @default("{}") @map("comms_preferences")
  engagementScore      Int?                 @map("engagement_score") @db.SmallInt
  engagementBand       String?              @map("engagement_band")
  lastActivityAt       DateTime?            @map("last_activity_at") @db.Timestamptz(6)
  mergedIntoId         String?              @map("merged_into_id") @db.Uuid
  isPrimary            Boolean              @default(true) @map("is_primary")
  addressLine1         String?              @map("address_line1")
  addressLine2         String?              @map("address_line2")
  city                 String?
  county               String?
  postcode             String?
  country              String?              @default("GB")
  householdMemberships HouseholdMember[]
  lifecycleHistory     LifecycleHistory[]
  person_activities    PersonActivity[]
  relationshipsFrom    PersonRelationship[] @relation("RelationshipFrom")
  relationshipsTo      PersonRelationship[] @relation("RelationshipTo")
  personRoles          PersonRole[]
  personTags           PersonTag[]
  segment_memberships  SegmentMembership[]

  @@index([tenantId, email], map: "customers_tenant_email_idx")
  @@index([tenantId, email], map: "customers_tenant_id_email_idx")
  @@index([tenantId], map: "customers_tenant_id_idx")
  @@index([tenantId, engagementBand], map: "idx_customers_tenant_engagement")
  @@index([tenantId, lifecycleState], map: "idx_customers_tenant_lifecycle")
  @@map("persons")
  @@schema("people")
}

model LifecycleHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  fromState  String?  @map("from_state")
  toState    String   @map("to_state")
  reason     String?
  changedBy  String?  @map("changed_by")
  changedAt  DateTime @default(now()) @map("changed_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_lifecycle_history_tenant")
  @@map("lifecycle_history")
  @@schema("people")
}

model Tag {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  name       String
  colour     String?
  source     String      @default("manual")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  personTags PersonTag[]

  @@unique([tenantId, name])
  @@index([tenantId], map: "idx_tags_tenant")
  @@map("tags")
  @@schema("people")
}

model PersonRole {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  role         String
  contextType  String?   @map("context_type")
  contextId    String?   @map("context_id") @db.Uuid
  contextLabel String?   @map("context_label")
  status       String    @default("active")
  startsAt     DateTime? @map("starts_at") @db.Date
  endsAt       DateTime? @map("ends_at") @db.Date
  notes        String?
  assignedBy   String?   @map("assigned_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "idx_person_roles_customer")
  @@index([tenantId], map: "idx_person_roles_tenant")
  @@index([tenantId, role], map: "idx_person_roles_tenant_role")
  @@map("person_roles")
  @@schema("people")
}

model PersonTag {
  customerId String    @map("customer_id") @db.Uuid
  tagId      String    @map("tag_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  appliedBy  String?   @map("applied_by")
  appliedAt  DateTime  @default(now()) @map("applied_at")
  expiresAt  DateTime? @map("expires_at")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([customerId], map: "idx_person_tags_customer")
  @@index([tagId], map: "idx_person_tags_tag")
  @@index([tenantId], map: "idx_person_tags_tenant")
  @@map("person_tags")
  @@schema("people")
}

model Household {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at")
  members   HouseholdMember[]

  @@index([tenantId], map: "idx_households_tenant")
  @@map("households")
  @@schema("people")
}

model HouseholdMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  householdId String    @map("household_id") @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  role        String    @default("member")
  createdAt   DateTime  @default(now()) @map("created_at")
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, customerId])
  @@index([customerId], map: "idx_household_members_customer")
  @@index([householdId], map: "idx_household_members_household")
  @@index([tenantId], map: "idx_household_members_tenant")
  @@map("household_members")
  @@schema("people")
}

model PersonRelationship {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  fromCustomerId String   @map("from_customer_id") @db.Uuid
  toCustomerId   String   @map("to_customer_id") @db.Uuid
  relationship   String
  createdAt      DateTime @default(now()) @map("created_at")
  fromCustomer   Customer @relation("RelationshipFrom", fields: [fromCustomerId], references: [id], onDelete: Cascade)
  toCustomer     Customer @relation("RelationshipTo", fields: [toCustomerId], references: [id], onDelete: Cascade)

  @@unique([fromCustomerId, toCustomerId, relationship])
  @@index([fromCustomerId], map: "idx_person_relationships_from")
  @@index([tenantId], map: "idx_person_relationships_tenant")
  @@index([toCustomerId], map: "idx_person_relationships_to")
  @@map("person_relationships")
  @@schema("people")
}

model PersonActivity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  personId   String   @map("person_id") @db.Uuid
  eventType  String   @map("event_type")
  title      String
  meta       Json     @default("{}")
  sourceId   String?  @map("source_id")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  persons    Customer @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType], map: "idx_person_activities_event_type")
  @@index([tenantId, personId, occurredAt(sort: Desc)], map: "idx_person_activities_person")
  @@map("person_activities")
  @@schema("people")
}

model Segment {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  name        String
  description String?
  type        String              @default("static")
  conditions  Json                @default("[]")
  memberCount Int                 @default(0) @map("member_count")
  lastBuiltAt DateTime?           @map("last_built_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships SegmentMembership[]

  @@index([tenantId], map: "idx_segments_tenant")
  @@index([tenantId, type], map: "idx_segments_tenant_type")
  @@map("segments")
  @@schema("people")
}

model SegmentMembership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  segmentId String   @map("segment_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  addedBy   String?  @map("added_by")
  persons   Customer @relation(fields: [personId], references: [id], onDelete: Cascade)
  segment   Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([segmentId, personId])
  @@index([tenantId, personId], map: "idx_segment_memberships_person")
  @@index([segmentId], map: "idx_segment_memberships_segment")
  @@map("segment_memberships")
  @@schema("people")
}
