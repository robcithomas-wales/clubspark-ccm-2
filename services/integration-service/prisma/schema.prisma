generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  directUrl = env("DIRECT_DATABASE_URL")
  schemas  = ["integration"]
}

model ApiKey {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  keyHash   String    @unique @map("key_hash")
  scopes    String[]
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  usage ApiKeyUsage[]

  @@index([tenantId])
  @@index([keyHash])
  @@schema("integration")
  @@map("api_keys")
}

model ApiKeyUsage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  apiKeyId     String   @map("api_key_id") @db.Uuid
  endpoint     String
  responseCode Int      @map("response_code")
  timestamp    DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId, timestamp])
  @@schema("integration")
  @@map("api_key_usage")
}

model WebhookSubscription {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  eventTypes  String[] @map("event_types")
  endpointUrl String   @map("endpoint_url")
  secretHash  String   @map("secret_hash")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([tenantId, isActive])
  @@schema("integration")
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  eventType      String                @map("event_type")
  payload        Json
  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  nextRetryAt    DateTime?             @map("next_retry_at")
  responseCode   Int?                  @map("response_code")
  responseBody   String?               @map("response_body")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([status, nextRetryAt])
  @@schema("integration")
  @@map("webhook_deliveries")
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
  dead

  @@schema("integration")
}

model OAuthConnection {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  provider     String    // 'xero' | 'quickbooks'
  providerTenantId String? @map("provider_tenant_id") // Xero tenantId / QBO realmId
  accessToken  String    @map("access_token")  // encrypted at rest
  refreshToken String    @map("refresh_token") // encrypted at rest
  tokenExpiry  DateTime  @map("token_expiry")
  scopes       String[]
  connectedAt  DateTime  @default(now()) @map("connected_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  disconnectedAt DateTime? @map("disconnected_at")

  syncLogs AccountingSyncLog[]

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@schema("integration")
  @@map("oauth_connections")
}

model AccountingSettings {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  provider         String   // 'xero' | 'quickbooks'
  revenueAccountCode String @map("revenue_account_code")  // e.g. '200' in Xero
  taxRateId        String?  @map("tax_rate_id")            // provider tax rate reference
  invoiceMode      String   @default("AUTHORISED") @map("invoice_mode") // 'DRAFT' | 'AUTHORISED'
  currencyCode     String   @default("GBP") @map("currency_code")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@schema("integration")
  @@map("accounting_settings")
}

model AccountingSyncLog {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId   String              @map("connection_id") @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  eventType      String              @map("event_type")
  sourceId       String              @map("source_id")       // paymentId / membershipId etc.
  sourceType     String              @map("source_type")     // 'payment' | 'membership'
  providerRef    String?             @map("provider_ref")    // Xero invoice ID etc.
  status         AccountingSyncStatus @default(pending)
  attempts       Int                 @default(0)
  errorMessage   String?             @map("error_message")
  nextRetryAt    DateTime?           @map("next_retry_at")
  syncedAt       DateTime?           @map("synced_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  connection OAuthConnection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, sourceId, eventType])
  @@index([status, nextRetryAt])
  @@index([tenantId, sourceId])
  @@schema("integration")
  @@map("accounting_sync_log")
}

enum AccountingSyncStatus {
  pending
  synced
  failed
  dead

  @@schema("integration")
}
