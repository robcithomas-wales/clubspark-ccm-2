generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["integration"]
}

model ApiKey {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  name      String
  keyHash   String        @unique @map("key_hash")
  scopes    String[]      @default([])
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)
  usage     ApiKeyUsage[]

  @@index([tenantId])
  @@index([keyHash])
  @@map("api_keys")
  @@schema("integration")
}

model ApiKeyUsage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  apiKeyId     String   @map("api_key_id") @db.Uuid
  endpoint     String
  responseCode Int      @map("response_code")
  timestamp    DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId, timestamp])
  @@map("api_key_usage")
  @@schema("integration")
}

model WebhookSubscription {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  name        String
  eventTypes  String[]          @default([]) @map("event_types")
  endpointUrl String            @map("endpoint_url")
  secretHash  String            @map("secret_hash")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deliveries  WebhookDelivery[]

  @@index([tenantId, isActive])
  @@map("webhook_subscriptions")
  @@schema("integration")
}

model WebhookDelivery {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  eventType      String                @map("event_type")
  payload        Json
  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  nextRetryAt    DateTime?             @map("next_retry_at") @db.Timestamptz(6)
  responseCode   Int?                  @map("response_code")
  responseBody   String?               @map("response_body")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscription   WebhookSubscription   @relation(fields: [subscriptionId], references: [id])

  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
  @@schema("integration")
}

model OAuthConnection {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  provider         String
  providerTenantId String?             @map("provider_tenant_id")
  accessToken      String              @map("access_token")
  refreshToken     String              @map("refresh_token")
  tokenExpiry      DateTime            @map("token_expiry") @db.Timestamptz(6)
  scopes           String[]            @default([])
  connectedAt      DateTime            @default(now()) @map("connected_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  disconnectedAt   DateTime?           @map("disconnected_at") @db.Timestamptz(6)
  syncLogs         AccountingSyncLog[]

  @@unique([tenantId, provider], map: "oauth_connections_tenant_provider_key")
  @@index([tenantId])
  @@map("oauth_connections")
  @@schema("integration")
}

model AccountingSettings {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @unique @map("tenant_id") @db.Uuid
  provider           String
  revenueAccountCode String   @map("revenue_account_code")
  taxRateId          String?  @map("tax_rate_id")
  invoiceMode        String   @default("AUTHORISED") @map("invoice_mode")
  currencyCode       String   @default("GBP") @map("currency_code")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("accounting_settings")
  @@schema("integration")
}

model AccountingSyncLog {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId String               @map("connection_id") @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  eventType    String               @map("event_type")
  sourceId     String               @map("source_id")
  sourceType   String               @map("source_type")
  providerRef  String?              @map("provider_ref")
  status       AccountingSyncStatus @default(pending)
  attempts     Int                  @default(0)
  errorMessage String?              @map("error_message")
  nextRetryAt  DateTime?            @map("next_retry_at") @db.Timestamptz(6)
  syncedAt     DateTime?            @map("synced_at") @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  connection   OAuthConnection      @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, sourceId, eventType], map: "accounting_sync_log_connection_source_event_key")
  @@index([status, nextRetryAt])
  @@index([tenantId, sourceId])
  @@map("accounting_sync_log")
  @@schema("integration")
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
  dead

  @@schema("integration")
}

enum AccountingSyncStatus {
  pending
  synced
  failed
  dead

  @@schema("integration")
}
