PORT=4016
NODE_ENV=development
DATABASE_URL=postgresql://...

# Session-mode connection used ONLY by prisma migrate/introspect.
# Supabase: same credentials, port 5432 (NOT the 6543 transaction pooler, which
# hangs on DDL). Local Postgres: same value as DATABASE_URL.
DIRECT_DATABASE_URL=
DATABASE_READ_URL=postgresql://...
SUPABASE_URL=https://your-project.supabase.co
# HMAC secret for hashing API key plaintexts — generate with: openssl rand -hex 32
API_KEY_HASH_SECRET=
