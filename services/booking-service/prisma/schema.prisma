// ClubSpark — Booking Service Prisma Schema
// Owns: booking.bookings, booking.booking_add_ons, booking.booking_rules,
//       booking.pricing_rules, booking.sessions, booking.session_participants
//
// Models ONLY the booking schema. Cross-schema reads (venue.*, people.*, auth.*,
// coaching.*) are raw SQL and are being removed — see
// docs/architecture/cross-schema-coupling-inventory.md.

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["booking"]
}

model BookingSeries {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  organisationId  String?   @map("organisation_id") @db.Uuid
  venueId         String    @map("venue_id") @db.Uuid
  resourceId      String    @map("resource_id") @db.Uuid
  bookableUnitId  String    @map("bookable_unit_id") @db.Uuid
  customerId      String?   @map("customer_id") @db.Uuid
  bookingSource   String?   @map("booking_source")
  rrule           String
  slotStartsAt    String    @map("slot_starts_at")
  slotEndsAt      String    @map("slot_ends_at")
  paymentStatus   String    @default("unpaid") @map("payment_status")
  notes           String?
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  minSessions     Int?      @map("min_sessions")
  maxSessions     Int?      @map("max_sessions")
  pricePerSession Decimal?  @map("price_per_session") @db.Decimal(10, 2)
  discountPct     Decimal?  @map("discount_pct") @db.Decimal(5, 2)
  currency        String    @default("GBP") @db.Char(3)
  bookings        Booking[]

  @@index([tenantId], map: "booking_series_tenant_idx")
  @@index([tenantId, status], map: "booking_series_tenant_status_idx")
  @@map("booking_series")
  @@schema("booking")
}

model Booking {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  venueId           String                @map("venue_id") @db.Uuid
  resourceId        String                @map("resource_id") @db.Uuid
  bookableUnitId    String                @map("bookable_unit_id") @db.Uuid
  customerId        String?               @map("customer_id") @db.Uuid
  startsAt          DateTime              @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime              @map("ends_at") @db.Timestamptz(6)
  status            String                @default("active")
  bookingReference  String?               @map("booking_reference")
  notes             String?
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt       DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  bookingSource     String?               @map("booking_source")
  organisationId    String?               @map("organisation_id") @db.Uuid
  paymentStatus     String                @default("unpaid") @map("payment_status") @db.VarChar(20)
  seriesId          String?               @map("series_id") @db.Uuid
  optionalUnitIds   String[]              @default([]) @map("optional_unit_ids") @db.Uuid
  approvedBy        String?               @map("approved_by")
  approvedAt        DateTime?             @map("approved_at") @db.Timestamptz(6)
  adminOverride     Boolean               @default(false) @map("admin_override")
  price             Decimal?              @db.Decimal(10, 2)
  currency          String                @default("GBP") @db.Char(3)
  lessonTypeId      String?               @map("lesson_type_id") @db.Uuid
  coachId           String?               @map("coach_id") @db.Uuid
  reminderSentAt    DateTime?             @map("reminder_sent_at") @db.Timestamptz(6)
  bookedForPersonId String?               @map("booked_for_person_id") @db.Uuid
  refundPct         Decimal?              @map("refund_pct") @db.Decimal(5, 2)
  refundAmount      Decimal?              @map("refund_amount") @db.Decimal(10, 2)
  refundStatus      String?               @map("refund_status")
  addOns            BookingAddOn[]
  participants      BookingParticipant[]
  paymentSplits     BookingPaymentSplit[]
  series            BookingSeries?        @relation(fields: [seriesId], references: [id])

  @@index([tenantId])
  @@index([tenantId, customerId], map: "bookings_tenant_customer_idx")
  @@index([tenantId, paymentStatus], map: "bookings_tenant_payment_status_idx")
  @@index([tenantId, startsAt, endsAt], map: "bookings_tenant_starts_ends_idx")
  @@index([tenantId, status], map: "bookings_tenant_status_idx")
  @@index([tenantId, bookableUnitId], map: "bookings_tenant_unit_idx")
  @@index([tenantId], map: "idx_bookings_tenant_id")
  @@map("bookings")
  @@schema("booking")
}

model BookingAddOn {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  addOnId   String   @map("add_on_id") @db.Uuid
  quantity  Int      @default(1)
  price     Decimal  @default(0) @db.Decimal(10, 2)
  currency  String   @default("GBP") @db.Char(3)
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  booking   Booking  @relation(fields: [bookingId], references: [id])

  @@map("booking_add_ons")
  @@schema("booking")
}

model BookingRule {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                    @map("tenant_id") @db.Uuid
  name                 String
  description          String?
  subjectType          String                    @default("everyone") @map("subject_type")
  subjectRef           String?                   @map("subject_ref")
  scopeType            String                    @default("organisation") @map("scope_type")
  scopeId              String?                   @map("scope_id") @db.Uuid
  daysOfWeek           Int[]                     @map("days_of_week")
  timeFrom             String?                   @map("time_from")
  timeTo               String?                   @map("time_to")
  canBook              Boolean                   @default(true) @map("can_book")
  requiresApproval     Boolean                   @default(false) @map("requires_approval")
  advanceDays          Int?                      @map("advance_days")
  minSlotMinutes       Int?                      @map("min_slot_minutes")
  maxSlotMinutes       Int?                      @map("max_slot_minutes")
  bookingPeriodDays    Int?                      @map("booking_period_days")
  maxBookingsPerPeriod Int?                      @map("max_bookings_per_period")
  allowSeries          Boolean                   @default(true) @map("allow_series")
  pricePerSlot         Decimal?                  @map("price_per_slot") @db.Decimal(10, 2)
  priceCurrency        String                    @default("GBP") @map("price_currency") @db.VarChar(3)
  minParticipants      Int?                      @map("min_participants")
  maxParticipants      Int?                      @map("max_participants")
  priority             Int                       @default(0)
  isActive             Boolean                   @default(true) @map("is_active")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @default(now()) @updatedAt @map("updated_at")
  purposePrices        BookingRulePurposePrice[]

  @@index([tenantId, scopeType, scopeId], map: "booking_rules_scope_idx")
  @@index([tenantId, isActive], map: "booking_rules_tenant_active_idx")
  @@index([tenantId], map: "booking_rules_tenant_idx")
  @@map("booking_rules")
  @@schema("booking")
}

model BookingRulePurposePrice {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId   String      @map("rule_id") @db.Uuid
  purpose  String
  price    Decimal     @db.Decimal(10, 2)
  currency String      @default("GBP") @db.VarChar(3)
  rule     BookingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, purpose])
  @@index([ruleId], map: "booking_rule_purpose_prices_rule_idx")
  @@map("booking_rule_purpose_prices")
  @@schema("booking")
}

model PricingRule {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  name                     String
  label                    String?
  description              String?
  scopeType                String   @default("organisation") @map("scope_type")
  scopeId                  String?  @map("scope_id") @db.Uuid
  daysOfWeek               Int[]    @default([]) @map("days_of_week")
  timeFrom                 String?  @map("time_from")
  timeTo                   String?  @map("time_to")
  ratePerHour              Decimal  @map("rate_per_hour") @db.Decimal(10, 2)
  currency                 String   @default("GBP") @db.VarChar(3)
  lightingSurchargePerHour Decimal? @map("lighting_surcharge_per_hour") @db.Decimal(10, 2)
  memberDiscountPct        Decimal? @map("member_discount_pct") @db.Decimal(5, 2)
  priority                 Int      @default(0)
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, scopeType, scopeId], map: "pricing_rules_scope_idx")
  @@index([tenantId, isActive], map: "pricing_rules_tenant_active_idx")
  @@index([tenantId], map: "pricing_rules_tenant_idx")
  @@map("pricing_rules")
  @@schema("booking")
}

model RefundPolicy {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  venueId          String?  @map("venue_id") @db.Uuid
  hoursBeforeStart Int      @map("hours_before_start")
  refundPct        Decimal  @map("refund_pct") @db.Decimal(5, 2)
  priority         Int      @default(100)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId], map: "idx_refund_policies_tenant")
  @@index([tenantId, isActive], map: "idx_refund_policies_tenant_active")
  @@index([tenantId, venueId], map: "idx_refund_policies_venue")
  @@map("refund_policies")
  @@schema("booking")
}

model BookingParticipant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  personId  String?  @map("person_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bookingId], map: "idx_booking_participants_booking_id")
  @@index([tenantId, bookingId], map: "idx_booking_participants_tenant_booking")
  @@map("booking_participants")
  @@schema("booking")
}

model GroupSession {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                    @map("tenant_id") @db.Uuid
  organisationId      String?                   @map("organisation_id") @db.Uuid
  venueId             String                    @map("venue_id") @db.Uuid
  resourceId          String                    @map("resource_id") @db.Uuid
  bookableUnitId      String                    @map("bookable_unit_id") @db.Uuid
  name                String
  description         String?
  startsAt            DateTime                  @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime                  @map("ends_at") @db.Timestamptz(6)
  pricePerParticipant Decimal?                  @map("price_per_participant") @db.Decimal(10, 2)
  currency            String                    @default("GBP") @db.Char(3)
  minParticipants     Int?                      @map("min_participants")
  maxParticipants     Int?                      @map("max_participants")
  status              String                    @default("open")
  coachId             String?                   @map("coach_id") @db.Uuid
  notes               String?
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  participants        GroupSessionParticipant[]

  @@index([tenantId], map: "sessions_tenant_idx")
  @@index([tenantId, startsAt], map: "sessions_tenant_starts_idx")
  @@index([tenantId, status], map: "sessions_tenant_status_idx")
  @@index([tenantId, bookableUnitId], map: "sessions_unit_idx")
  @@map("sessions")
  @@schema("booking")
}

model GroupSessionParticipant {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String       @map("session_id") @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  customerId       String?      @map("customer_id") @db.Uuid
  participantName  String       @map("participant_name")
  participantEmail String?      @map("participant_email")
  status           String       @default("registered")
  paymentStatus    String       @default("unpaid") @map("payment_status")
  joinedAt         DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  session          GroupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, customerId], map: "session_participants_customer_idx")
  @@index([sessionId], map: "session_participants_session_idx")
  @@index([tenantId, sessionId], map: "session_participants_tenant_idx")
  @@map("session_participants")
  @@schema("booking")
}

model BookingPaymentSplit {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId     String   @map("booking_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  payerPersonId String?  @map("payer_person_id") @db.Uuid
  payerName     String   @map("payer_name")
  payerEmail    String?  @map("payer_email")
  amountDue     Decimal  @map("amount_due") @db.Decimal(10, 2)
  amountPaid    Decimal  @default(0) @map("amount_paid") @db.Decimal(10, 2)
  currency      String   @default("GBP") @db.Char(3)
  paymentStatus String   @default("unpaid") @map("payment_status")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bookingId], map: "idx_booking_payment_splits_booking")
  @@index([tenantId, bookingId], map: "idx_booking_payment_splits_tenant")
  @@map("booking_payment_splits")
  @@schema("booking")
}

/// Transactional outbox (MR-2). Written in the same transaction as the state
/// change that produced the event; delivered by OutboxRelay.
/// Accessed via raw SQL — modelled here so schema.prisma matches the database
/// and the drift gate stays green.
model EventOutbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  @@index([publishedAt, nextAttemptAt], map: "event_outbox_pending_idx")
  @@map("event_outbox")
  @@schema("booking")
}

/// Booking-owned read model of the Venue resource fields needed by create and pricing.
model VenueResourceProjection {
  tenantId        String    @map("tenant_id") @db.Uuid
  id              String    @db.Uuid
  venueId         String    @map("venue_id") @db.Uuid
  groupId         String?   @map("group_id") @db.Uuid
  hasLighting     Boolean?  @map("has_lighting")
  isActive        Boolean   @map("is_active")
  sourceUpdatedAt DateTime? @map("source_updated_at") @db.Timestamptz(6)
  projectedAt     DateTime  @default(now()) @map("projected_at") @db.Timestamptz(6)

  @@id([tenantId, id])
  @@index([tenantId, venueId], map: "venue_resource_projection_tenant_venue_idx")
  @@map("venue_resource_projection")
  @@schema("booking")
}

/// Booking-owned read model of Venue bookable-unit identity and validity.
model BookableUnitProjection {
  tenantId        String    @map("tenant_id") @db.Uuid
  id              String    @db.Uuid
  venueId         String    @map("venue_id") @db.Uuid
  resourceId      String    @map("resource_id") @db.Uuid
  name            String
  unitType        String    @map("unit_type")
  isActive        Boolean   @map("is_active")
  sourceUpdatedAt DateTime? @map("source_updated_at") @db.Timestamptz(6)
  projectedAt     DateTime  @default(now()) @map("projected_at") @db.Timestamptz(6)

  @@id([tenantId, id])
  @@index([tenantId, venueId], map: "bookable_unit_projection_tenant_venue_idx")
  @@index([tenantId, resourceId], map: "bookable_unit_projection_tenant_resource_idx")
  @@map("bookable_unit_projection")
  @@schema("booking")
}

/// Undirected Venue unit-conflict edges copied into Booking for availability checks.
model UnitConflictProjection {
  tenantId          String   @map("tenant_id") @db.Uuid
  unitId            String   @map("unit_id") @db.Uuid
  conflictingUnitId String   @map("conflicting_unit_id") @db.Uuid
  projectedAt       DateTime @default(now()) @map("projected_at") @db.Timestamptz(6)

  @@id([tenantId, unitId, conflictingUnitId])
  @@index([tenantId, conflictingUnitId], map: "unit_conflict_projection_reverse_idx")
  @@map("unit_conflict_projection")
  @@schema("booking")
}

/// Booking-owned occupancy read model sourced from Coaching lesson sessions.
model CoachingOccupancyProjection {
  tenantId        String   @map("tenant_id") @db.Uuid
  id              String   @db.Uuid
  bookableUnitId  String   @map("bookable_unit_id") @db.Uuid
  startsAt        DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(6)
  status          String
  sourceUpdatedAt DateTime @map("source_updated_at") @db.Timestamptz(6)
  projectedAt     DateTime @default(now()) @map("projected_at") @db.Timestamptz(6)

  @@id([tenantId, id])
  @@index([tenantId, bookableUnitId, startsAt, endsAt], map: "coaching_occupancy_lookup_idx")
  @@map("coaching_occupancy_projection")
  @@schema("booking")
}

/// Durable idempotency receipt for projection events.
model ProjectionEventReceipt {
  tenantId    String   @map("tenant_id") @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  eventType   String   @map("event_type")
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([tenantId, eventId])
  @@index([tenantId, processedAt], map: "projection_event_receipt_processed_idx")
  @@map("projection_event_receipts")
  @@schema("booking")
}

/// Latest source timestamp per projected entity, including deletion tombstones.
model ProjectionEntityCursor {
  tenantId        String   @map("tenant_id") @db.Uuid
  source          String
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id") @db.Uuid
  sourceUpdatedAt DateTime @map("source_updated_at") @db.Timestamptz(6)
  deleted         Boolean  @default(false)
  projectedAt     DateTime @default(now()) @map("projected_at") @db.Timestamptz(6)

  @@id([tenantId, source, entityType, entityId])
  @@index([tenantId, source, projectedAt], map: "projection_entity_cursor_source_idx")
  @@map("projection_entity_cursors")
  @@schema("booking")
}
