// ClubSpark — Coaching Service Prisma Schema
// Owns the coaching schema: coaches, lesson_types, coach_lesson_types, coach_availability, coach_blocks

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["coaching"]
}

model Coach {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  customerId        String?             @map("customer_id") @db.Uuid
  displayName       String              @map("display_name")
  bio               String?
  avatarUrl         String?             @map("avatar_url")
  specialties       String[]
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at")
  availability      CoachAvailability[]
  blocks            CoachBlock[]
  lessonTypes       CoachLessonType[]
  sessions          LessonSession[]
  programmeSessions ProgrammeSession[]  @relation("ProgrammeSessionCoach")
  programmes        Programme[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([customerId])
  @@map("coaches")
  @@schema("coaching")
}

model LessonType {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  name            String
  description     String?
  sport           String?
  durationMinutes Int               @map("duration_minutes")
  maxParticipants Int               @default(1) @map("max_participants")
  pricePerSession Decimal           @default(0) @map("price_per_session") @db.Decimal(10, 2)
  currency        String            @default("GBP")
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")
  coaches         CoachLessonType[]
  sessions        LessonSession[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, sport])
  @@map("lesson_types")
  @@schema("coaching")
}

model CoachLessonType {
  coachId      String     @map("coach_id") @db.Uuid
  lessonTypeId String     @map("lesson_type_id") @db.Uuid
  coach        Coach      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  lessonType   LessonType @relation(fields: [lessonTypeId], references: [id], onDelete: Cascade)

  @@id([coachId, lessonTypeId])
  @@index([coachId])
  @@index([lessonTypeId])
  @@map("coach_lesson_types")
  @@schema("coaching")
}

model CoachAvailability {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  coachId      String  @map("coach_id") @db.Uuid
  dayOfWeek    Int     @map("day_of_week")
  startTime    String  @map("start_time")
  endTime      String  @map("end_time")
  lessonTypeId String? @map("lesson_type_id") @db.Uuid
  coach        Coach   @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([tenantId])
  @@index([coachId, dayOfWeek])
  @@map("coach_availability")
  @@schema("coaching")
}

model LessonSession {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  coachId            String     @map("coach_id") @db.Uuid
  lessonTypeId       String     @map("lesson_type_id") @db.Uuid
  customerId         String?    @map("customer_id") @db.Uuid
  startsAt           DateTime   @map("starts_at")
  endsAt             DateTime   @map("ends_at")
  status             String     @default("scheduled")
  notes              String?
  paymentStatus      String     @default("unpaid") @map("payment_status")
  priceCharged       Decimal?   @map("price_charged") @db.Decimal(10, 2)
  cancellationReason String?    @map("cancellation_reason")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at")
  bookableUnitId     String?    @map("bookable_unit_id") @db.Uuid
  coach              Coach      @relation(fields: [coachId], references: [id])
  lessonType         LessonType @relation(fields: [lessonTypeId], references: [id])

  @@index([tenantId])
  @@index([coachId])
  @@index([lessonTypeId])
  @@index([customerId])
  @@index([tenantId, startsAt])
  @@index([tenantId, status])
  @@map("lesson_sessions")
  @@schema("coaching")
}

model Programme {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  name            String
  description     String?
  sport           String?
  coachId         String?            @map("coach_id") @db.Uuid
  venueId         String?            @map("venue_id") @db.Uuid
  maxParticipants Int                @default(10) @map("max_participants")
  minParticipants Int                @default(1) @map("min_participants")
  price           Decimal            @default(0) @db.Decimal(10, 2)
  currency        String             @default("GBP")
  enrollsFrom     DateTime?          @map("enrolls_from")
  enrollsUntil    DateTime?          @map("enrolls_until")
  status          String             @default("draft")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  enrolments      Enrolment[]
  sessions        ProgrammeSession[]
  coach           Coach?             @relation(fields: [coachId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, sport])
  @@index([coachId])
  @@map("programmes")
  @@schema("coaching")
}

model ProgrammeSession {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  programmeId    String       @map("programme_id") @db.Uuid
  coachId        String?      @map("coach_id") @db.Uuid
  bookableUnitId String?      @map("bookable_unit_id") @db.Uuid
  startsAt       DateTime     @map("starts_at")
  endsAt         DateTime     @map("ends_at")
  status         String       @default("scheduled")
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  attendances    Attendance[]
  coach          Coach?       @relation("ProgrammeSessionCoach", fields: [coachId], references: [id])
  programme      Programme    @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([programmeId])
  @@index([coachId])
  @@index([tenantId, startsAt])
  @@map("programme_sessions")
  @@schema("coaching")
}

model Enrolment {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  programmeId String       @map("programme_id") @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  status      String       @default("confirmed")
  orderId     String?      @map("order_id") @db.Uuid
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  attendances Attendance[]
  programme   Programme    @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([programmeId, customerId])
  @@index([tenantId])
  @@index([programmeId])
  @@index([customerId])
  @@map("enrolments")
  @@schema("coaching")
}

model Attendance {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  programmeSessionId String           @map("programme_session_id") @db.Uuid
  enrolmentId        String           @map("enrolment_id") @db.Uuid
  customerId         String           @map("customer_id") @db.Uuid
  attended           Boolean?
  notes              String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  enrolment          Enrolment        @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  programmeSession   ProgrammeSession @relation(fields: [programmeSessionId], references: [id], onDelete: Cascade)

  @@unique([programmeSessionId, enrolmentId])
  @@index([tenantId])
  @@index([programmeSessionId])
  @@index([enrolmentId])
  @@index([customerId])
  @@map("attendances")
  @@schema("coaching")
}

model CoachBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  coachId   String   @map("coach_id") @db.Uuid
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([tenantId])
  @@index([coachId, startsAt, endsAt])
  @@map("coach_blocks")
  @@schema("coaching")
}
