// ClubSpark — Coaching Service Prisma Schema
// Owns the coaching schema: coaches, lesson_types, coach_lesson_types, coach_availability, coach_blocks

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  directUrl = env("DIRECT_DATABASE_URL")
  schemas  = ["coaching"]
}

// A coach profile. Linked to a person in people-service via customerId (UUID cross-reference).
model Coach {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  customerId   String?  @map("customer_id") @db.Uuid  // optional link to people.persons (cross-service ref, no hard constraint)
  displayName  String   @map("display_name")
  bio          String?
  avatarUrl    String?  @map("avatar_url")
  specialties  String[] // e.g. ["tennis", "padel", "junior coaching"]
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  lessonTypes       CoachLessonType[]
  availability      CoachAvailability[]
  blocks            CoachBlock[]
  sessions          LessonSession[]
  programmes        Programme[]
  programmeSessions ProgrammeSession[] @relation("ProgrammeSessionCoach")

  @@map("coaches")
  @@schema("coaching")
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([customerId])
}

// A type of lesson/session that a venue offers (e.g. "Junior Tennis", "Adult Padel Clinic")
model LessonType {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  description      String?
  sport            String?  // e.g. "tennis", "padel", "squash"
  durationMinutes  Int      @map("duration_minutes")
  maxParticipants  Int      @default(1) @map("max_participants")
  pricePerSession  Decimal  @default(0) @map("price_per_session") @db.Decimal(10, 2)
  currency         String   @default("GBP")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  coaches  CoachLessonType[]
  sessions LessonSession[]

  @@map("lesson_types")
  @@schema("coaching")
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, sport])
}

// Join table: which lesson types a coach delivers
model CoachLessonType {
  coachId       String @map("coach_id") @db.Uuid
  lessonTypeId  String @map("lesson_type_id") @db.Uuid

  coach      Coach      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  lessonType LessonType @relation(fields: [lessonTypeId], references: [id], onDelete: Cascade)

  @@id([coachId, lessonTypeId])
  @@map("coach_lesson_types")
  @@schema("coaching")
  @@index([coachId])
  @@index([lessonTypeId])
}

// Recurring weekly availability windows for a coach.
// dayOfWeek: 0 = Sunday … 6 = Saturday (matches JS Date.getDay())
model CoachAvailability {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  coachId      String  @map("coach_id") @db.Uuid
  dayOfWeek    Int     @map("day_of_week")   // 0–6
  startTime    String  @map("start_time")    // "HH:MM" 24-hour
  endTime      String  @map("end_time")      // "HH:MM" 24-hour
  lessonTypeId String? @map("lesson_type_id") @db.Uuid // null = available for any type

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@map("coach_availability")
  @@schema("coaching")
  @@index([coachId])
  @@index([tenantId])
  @@index([coachId, dayOfWeek])
}

// A scheduled lesson / session instance — a concrete booking of a coach + lesson type
// for a specific time. customerId is a cross-ref to people-service (no hard FK).
model LessonSession {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  coachId            String   @map("coach_id") @db.Uuid
  lessonTypeId       String   @map("lesson_type_id") @db.Uuid
  customerId         String?  @map("customer_id") @db.Uuid  // optional link to people.persons
  bookableUnitId     String?  @map("bookable_unit_id") @db.Uuid  // optional link to venue.bookable_units (no hard FK; enables conflict detection)
  startsAt           DateTime @map("starts_at")
  endsAt             DateTime @map("ends_at")
  status             String   @default("scheduled") // scheduled | confirmed | completed | cancelled | no_show
  notes              String?
  paymentStatus      String   @default("unpaid") @map("payment_status") // unpaid | paid | waived
  priceCharged       Decimal? @map("price_charged") @db.Decimal(10, 2)
  cancellationReason String?  @map("cancellation_reason")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  coach      Coach      @relation(fields: [coachId], references: [id], onDelete: Restrict)
  lessonType LessonType @relation(fields: [lessonTypeId], references: [id], onDelete: Restrict)

  @@map("lesson_sessions")
  @@schema("coaching")
  @@index([tenantId])
  @@index([coachId])
  @@index([lessonTypeId])
  @@index([customerId])
  @@index([tenantId, startsAt])
  @@index([tenantId, status])
}

// ─── Programme domain ─────────────────────────────────────────────────────────
// Programme = structured group coaching offer (course, camp, academy).
// LessonSession (above) remains the 1:1 appointment model — these are separate.

model Programme {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  description     String?
  sport           String?
  coachId         String?  @map("coach_id") @db.Uuid
  venueId         String?  @map("venue_id") @db.Uuid           // cross-service ref, no hard FK
  maxParticipants Int      @default(10) @map("max_participants")
  minParticipants Int      @default(1)  @map("min_participants")
  price           Decimal  @default(0)  @db.Decimal(10, 2)
  currency        String   @default("GBP")
  enrollsFrom     DateTime? @map("enrolls_from")
  enrollsUntil    DateTime? @map("enrolls_until")
  status          String   @default("draft")  // draft | published | closed | ended | cancelled
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  coach      Coach?             @relation(fields: [coachId], references: [id], onDelete: SetNull)
  sessions   ProgrammeSession[]
  enrolments Enrolment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, sport])
  @@index([coachId])
  @@map("programmes")
  @@schema("coaching")
}

model ProgrammeSession {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  programmeId    String   @map("programme_id") @db.Uuid
  coachId        String?  @map("coach_id") @db.Uuid
  bookableUnitId String?  @map("bookable_unit_id") @db.Uuid    // cross-service ref, no hard FK
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  status         String   @default("scheduled")  // scheduled | completed | cancelled
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  programme   Programme  @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  coach       Coach?     @relation("ProgrammeSessionCoach", fields: [coachId], references: [id], onDelete: SetNull)
  attendances Attendance[]

  @@index([tenantId])
  @@index([programmeId])
  @@index([coachId])
  @@index([tenantId, startsAt])
  @@map("programme_sessions")
  @@schema("coaching")
}

model Enrolment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  programmeId String   @map("programme_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid            // cross-service ref, no hard FK
  status      String   @default("confirmed")  // pending | confirmed | cancelled | waitlisted
  orderId     String?  @map("order_id") @db.Uuid               // cross-service ref, no hard FK
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  programme   Programme  @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@unique([programmeId, customerId])
  @@index([tenantId])
  @@index([programmeId])
  @@index([customerId])
  @@map("enrolments")
  @@schema("coaching")
}

model Attendance {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  programmeSessionId String   @map("programme_session_id") @db.Uuid
  enrolmentId        String   @map("enrolment_id") @db.Uuid
  customerId         String   @map("customer_id") @db.Uuid     // denormalised for query speed
  attended           Boolean?                                   // null = not yet recorded
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  programmeSession ProgrammeSession @relation(fields: [programmeSessionId], references: [id], onDelete: Cascade)
  enrolment        Enrolment        @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@unique([programmeSessionId, enrolmentId])
  @@index([tenantId])
  @@index([programmeSessionId])
  @@index([enrolmentId])
  @@index([customerId])
  @@map("attendances")
  @@schema("coaching")
}

// One-off time blocks where a coach is NOT available (holiday, illness, etc.)
model CoachBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  coachId   String   @map("coach_id") @db.Uuid
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@map("coach_blocks")
  @@schema("coaching")
  @@index([coachId])
  @@index([tenantId])
  @@index([coachId, startsAt, endsAt])
}
