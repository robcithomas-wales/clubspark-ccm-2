// ClubSpark — Template Service Prisma Schema
// Replace this with the service-specific schema.
//
// Convention:
//   - Each service owns its own schema (booking.*, venue.*, customer.*, etc.)
//   - Cross-service data access goes via HTTP API, never via direct DB query
//   - Use @@map and @map to match existing PostgreSQL snake_case column names

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  directUrl = env("DIRECT_DATABASE_URL")
  schemas  = ["public"] // Replace with service schema: ["booking"] or ["venue"] etc.
}

// ─── Models ──────────────────────────────────────────────────────────────────
//
// REPLACE ExampleRecord with your service's real models, then update the
// `schemas` list above to your service's schema name.
//
// This placeholder is deliberately a real model rather than a comment: Prisma
// fails with "You don't have any models defined in your schema.prisma" when a
// schema has none, which breaks `npm run prisma:generate:all` on a clean clone
// and means every service scaffolded from this template starts out unable to
// generate. Keep at least one model here.
//
// Note it is not backed by a migration — nothing creates this table. That is
// fine: `prisma generate` never touches the database. Do not run
// `prisma migrate` against template-service.

model ExampleRecord {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("example_records")
  @@schema("public")
  @@index([tenantId])
}
