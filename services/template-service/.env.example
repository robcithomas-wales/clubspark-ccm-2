# ─── Service ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
# Connect via Supabase Supavisor pooler endpoint (not direct connection)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:password@localhost:5432/clubspark

# Session-mode connection used ONLY by prisma migrate/introspect.
# Supabase: same credentials, port 5432 (NOT the 6543 transaction pooler, which
# hangs on DDL). Local Postgres: same value as DATABASE_URL.
DIRECT_DATABASE_URL=

# Read replica — used for list/reporting queries to keep writes on primary
DATABASE_READ_URL=postgresql://postgres:password@localhost:5432/clubspark

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Service bus (Azure Service Bus in production, Redis pub/sub locally) ──────
# SERVICE_BUS_CONNECTION_STRING=  # Azure production only

# ─── Observability ─────────────────────────────────────────────────────────────
# APPLICATIONINSIGHTS_CONNECTION_STRING=  # Azure production only

# Shared secret authenticating internal service-to-service endpoints and domain
# event delivery. The receiving guards are FAIL-CLOSED, so calls between services
# are rejected without it.
#
# Every service must use the SAME value. The default below works out of the box;
# replace it in staging/production with: openssl rand -hex 32
INTERNAL_SECRET=dev-internal-secret-change-in-production

# Supabase project — JWTs are verified against its JWKS endpoint.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The region this service instance serves, e.g. eu-west-2.
# Required with no default: a service that does not know its own region cannot
# refuse a tenant whose data must stay elsewhere, and data residency is a legal
# boundary. An unset value stops the service at startup, which is the safe way
# to be wrong.
CLUBSPARK_REGION=eu-west-2
