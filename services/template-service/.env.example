# ─── Service ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
# Connect via Supabase Supavisor pooler endpoint (not direct connection)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:password@localhost:5432/clubspark

# Session-mode connection used ONLY by prisma migrate/introspect.
# Supabase: same credentials, port 5432 (NOT the 6543 transaction pooler, which
# hangs on DDL). Local Postgres: same value as DATABASE_URL.
DIRECT_DATABASE_URL=

# Read replica — used for list/reporting queries to keep writes on primary
DATABASE_READ_URL=postgresql://postgres:password@localhost:5432/clubspark

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Service bus (Azure Service Bus in production, Redis pub/sub locally) ──────
# SERVICE_BUS_CONNECTION_STRING=  # Azure production only

# ─── Observability ─────────────────────────────────────────────────────────────
# APPLICATIONINSIGHTS_CONNECTION_STRING=  # Azure production only
