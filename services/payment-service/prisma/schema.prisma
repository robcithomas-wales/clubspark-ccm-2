// ClubSpark — Payment Service Prisma Schema
// Owns the payment schema: provider_configs, payments, payment_attempts, refunds, webhook_events

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["payment"]
}

model ProviderConfig {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  provider      String
  currency      String         @default("GBP") @db.Char(3)
  isDefault     Boolean        @default(true) @map("is_default")
  credentials   Json
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  payments      Payment[]
  webhookEvents WebhookEvent[]

  @@unique([tenantId, provider, currency])
  @@index([tenantId, isActive])
  @@index([tenantId, isDefault])
  @@map("provider_configs")
  @@schema("payment")
}

model Payment {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  idempotencyKey   String           @unique @map("idempotency_key")
  subjectType      String           @map("subject_type")
  subjectId        String           @map("subject_id") @db.Uuid
  customerId       String?          @map("customer_id") @db.Uuid
  providerConfigId String           @map("provider_config_id") @db.Uuid
  amount           Int
  currency         String           @default("GBP") @db.Char(3)
  gatewayRef       String?          @map("gateway_ref")
  status           PaymentStatus    @default(pending)
  failureReason    String?          @map("failure_reason")
  metadata         Json?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  attempts         PaymentAttempt[]
  providerConfig   ProviderConfig   @relation(fields: [providerConfigId], references: [id])
  refunds          Refund[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, customerId])
  @@index([gatewayRef])
  @@map("payments")
  @@schema("payment")
}

model PaymentAttempt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId    String   @map("payment_id") @db.Uuid
  gatewayRef   String?  @map("gateway_ref")
  status       String
  errorCode    String?  @map("error_code")
  errorMessage String?  @map("error_message")
  attemptedAt  DateTime @default(now()) @map("attempted_at") @db.Timestamptz(6)
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_attempts")
  @@schema("payment")
}

model Refund {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId  String       @map("payment_id") @db.Uuid
  amount     Int?
  currency   String       @default("GBP") @db.Char(3)
  gatewayRef String?      @map("gateway_ref")
  reason     String?
  status     RefundStatus @default(pending)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  payment    Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
  @@schema("payment")
}

model WebhookEvent {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerConfigId String?         @map("provider_config_id") @db.Uuid
  provider         String
  gatewayEventId   String?         @unique @map("gateway_event_id")
  eventType        String          @map("event_type")
  payload          Json
  processedAt      DateTime?       @map("processed_at") @db.Timestamptz(6)
  error            String?
  receivedAt       DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)
  providerConfig   ProviderConfig? @relation(fields: [providerConfigId], references: [id])

  @@index([provider, eventType])
  @@index([providerConfigId])
  @@map("webhook_events")
  @@schema("payment")
}

enum PaymentStatus {
  pending
  requires_action
  processing
  succeeded
  failed
  cancelled

  @@schema("payment")
}

enum RefundStatus {
  pending
  succeeded
  failed

  @@schema("payment")
}

enum ChargeRunStatus {
  draft
  sent
  completed
  cancelled

  @@schema("payment")
}
