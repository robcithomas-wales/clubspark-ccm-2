PORT=4011
NODE_ENV=development

DATABASE_URL=postgresql://user:password@localhost:5432/clubspark

# Session-mode connection used ONLY by prisma migrate/introspect.
# Supabase: same credentials, port 5432 (NOT the 6543 transaction pooler, which
# hangs on DDL). Local Postgres: same value as DATABASE_URL.
DIRECT_DATABASE_URL=
DATABASE_READ_URL=

SUPABASE_URL=https://your-project.supabase.co

# Credentials for each tenant's payment provider are stored per-tenant
# in payment.provider_configs (credentials jsonb column).
# In production, store secrets in Azure Key Vault — not in this table directly.

# Shared secret authenticating internal service-to-service endpoints and domain
# event delivery. The receiving guards are FAIL-CLOSED, so calls between services
# are rejected without it.
#
# Every service must use the SAME value. The default below works out of the box;
# replace it in staging/production with: openssl rand -hex 32
INTERNAL_SECRET=dev-internal-secret-change-in-production
