PORT=4010
NODE_ENV=development

# Primary database (write)
DATABASE_URL=postgresql://user:password@localhost:5432/clubspark

# Read replica (optional — falls back to DATABASE_URL)
DATABASE_READ_URL=

# Shared secret authenticating internal service-to-service endpoints
# (e.g. POST /memberships/internal/reassign-customer, called by people-service).
# REQUIRED: those routes skip tenant/JWT auth, so this is their only authenticator
# and the guard fails closed when it is unset. Must match the value in the
# calling services. Generate with: openssl rand -hex 32
INTERNAL_SECRET=
