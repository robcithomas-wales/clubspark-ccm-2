// ClubSpark — Entitlement Service Prisma Schema
// Owns the entitlements schema: plans, features, org subscriptions, add-ons, overrides.

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["entitlements"]
}

model Plan {
  id                    String            @id
  name                  String
  priceMonthly          Decimal?          @map("price_monthly") @db.Decimal(10, 2)
  priceAnnually         Decimal?          @map("price_annually") @db.Decimal(10, 2)
  transactionFeePercent Decimal?          @map("transaction_fee_percent") @db.Decimal(5, 2)
  includedSites         Int               @default(0) @map("included_sites")
  isCustom              Boolean           @default(false) @map("is_custom")
  sortOrder             Int               @default(0) @map("sort_order")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orgSubscriptions      OrgSubscription[]
  planFeatures          PlanFeature[]

  @@map("plans")
  @@schema("entitlements")
}

model Feature {
  id           String        @id
  name         String
  description  String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  add_ons      AddOn[]
  planFeatures PlanFeature[]

  @@map("features")
  @@schema("entitlements")
}

model PlanFeature {
  planId    String  @map("plan_id")
  featureId String  @map("feature_id")
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([planId, featureId])
  @@map("plan_features")
  @@schema("entitlements")
}

model OrgSubscription {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId      String    @unique @map("organisation_id")
  tenantId            String    @map("tenant_id") @db.Uuid
  planId              String    @map("plan_id")
  billingCycle        String    @default("monthly") @map("billing_cycle")
  status              String    @default("active") @map("status")
  trialEndsAt         DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodEnd    DateTime? @map("current_period_end") @db.Timestamptz(6)
  maxioSubscriptionId String?   @map("maxio_subscription_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan                Plan      @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId], map: "idx_org_subscriptions_tenant")
  @@map("org_subscriptions")
  @@schema("entitlements")
}

model OrgPlanOverride {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId         String   @unique @map("organisation_id")
  tenantId               String   @map("tenant_id") @db.Uuid
  priceOverride          Decimal? @map("price_override") @db.Decimal(10, 2)
  transactionFeeOverride Decimal? @map("transaction_fee_override") @db.Decimal(5, 2)
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId], map: "idx_org_plan_overrides_tenant")
  @@map("org_plan_overrides")
  @@schema("entitlements")
}

model AddOn {
  id        String     @id
  name      String
  price     Decimal    @db.Decimal(10, 2)
  interval  String
  featureId String?    @map("feature_id")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  features  Feature?   @relation(fields: [featureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orgAddOns OrgAddOn[]

  @@map("add_ons")
  @@schema("entitlements")
}

model OrgAddOn {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String   @map("organisation_id")
  tenantId         String   @map("tenant_id") @db.Uuid
  addOnId          String   @map("add_on_id")
  status           String   @default("active") @map("status")
  maxioComponentId String?  @map("maxio_component_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  addOn            AddOn    @relation(fields: [addOnId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organisationId, addOnId], map: "uq_org_add_ons")
  @@index([tenantId], map: "idx_org_add_ons_tenant")
  @@map("org_add_ons")
  @@schema("entitlements")
}
