PORT=4013
NODE_ENV=development

# Primary database (write) — the real target is Supabase-hosted Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/clubspark?schema=entitlement

# Read replica (optional — falls back to DATABASE_URL)
DATABASE_READ_URL=

# Supabase auth (JWTs are verified against this project's JWKS)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

