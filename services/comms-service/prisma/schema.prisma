// ClubSpark — Comms Service Prisma Schema
// Owns: comms.message_log, comms.suppression, comms.templates, comms.campaigns, comms.campaign_recipients

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["comms"]
}

model MessageLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  recipientEmail    String?   @map("recipient_email")
  recipientName     String?   @map("recipient_name")
  recipientPhone    String?   @map("recipient_phone")
  recipientPersonId String?   @map("recipient_person_id") @db.Uuid
  channel           String
  templateKey       String?   @map("template_key")
  subject           String?
  bodyPreview       String?   @map("body_preview")
  status            String    @default("queued")
  errorDetail       String?   @map("error_detail")
  sourceEventType   String?   @map("source_event_type")
  sourceEntityId    String?   @map("source_entity_id")
  sourceModule      String?   @map("source_module")
  campaignId        String?   @map("campaign_id") @db.Uuid
  providerMessageId String?   @map("provider_message_id")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz(6)
  openedAt          DateTime? @map("opened_at") @db.Timestamptz(6)
  clickedAt         DateTime? @map("clicked_at") @db.Timestamptz(6)
  bouncedAt         DateTime? @map("bounced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  campaign          Campaign? @relation(fields: [campaignId], references: [id], onUpdate: NoAction, map: "fk_message_log_campaign")

  @@index([campaignId], map: "idx_message_log_campaign")
  @@index([tenantId, channel], map: "idx_message_log_channel")
  @@index([createdAt(sort: Desc)], map: "idx_message_log_created_at")
  @@index([tenantId, sourceEventType], map: "idx_message_log_event_type")
  @@index([tenantId, status], map: "idx_message_log_status")
  @@index([tenantId], map: "idx_message_log_tenant")
  @@map("message_log")
  @@schema("comms")
}

model Suppression {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  email     String?
  phone     String?
  channel   String
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, email, channel])
  @@unique([tenantId, phone, channel])
  @@index([tenantId, email], map: "idx_suppression_email")
  @@index([tenantId, phone], map: "idx_suppression_phone")
  @@map("suppression")
  @@schema("comms")
}

model Template {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String?  @map("tenant_id") @db.Uuid
  key             String
  name            String
  channel         String
  isSystem        Boolean  @default(false) @map("is_system")
  isActive        Boolean  @default(true) @map("is_active")
  subjectTemplate String?  @map("subject_template")
  bodyTemplate    String?  @map("body_template")
  customFooter    String?  @map("custom_footer")
  smsTemplate     String?  @map("sms_template")
  replyTo         String?  @map("reply_to")
  fromName        String?  @map("from_name")
  variables       String[] @default([])
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, key])
  @@index([key], map: "idx_templates_key")
  @@index([tenantId], map: "idx_templates_tenant")
  @@map("templates")
  @@schema("comms")
}

model Campaign {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  name               String?
  channel            String
  audienceDefinition String?      @map("audience_definition")
  subject            String?
  body               String?
  templateId         String?      @map("template_id") @db.Uuid
  replyTo            String?      @map("reply_to")
  status             String       @default("draft")
  recipientCount     Int?         @map("recipient_count")
  sentCount          Int?         @map("sent_count")
  suppressedCount    Int?         @map("suppressed_count")
  scheduledAt        DateTime?    @map("scheduled_at") @db.Timestamptz(6)
  sentAt             DateTime?    @map("sent_at") @db.Timestamptz(6)
  createdBy          String?      @map("created_by")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  messages           MessageLog[]

  @@index([tenantId, status], map: "idx_campaigns_status")
  @@index([tenantId], map: "idx_campaigns_tenant")
  @@map("campaigns")
  @@schema("comms")
}

model SavedAudience {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String
  description    String?
  rulesJson      String   @map("rules_json")
  estimatedCount Int      @default(0) @map("estimated_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId], map: "idx_saved_audiences_tenant")
  @@map("saved_audiences")
  @@schema("comms")
}

model EventInbox {
  producer    String
  eventId     String    @map("event_id")
  tenantId    String?   @map("tenant_id") @db.Uuid
  eventType   String    @map("event_type")
  payloadHash String    @map("payload_hash")
  status      String    @default("processing")
  ownerId     String    @map("owner_id")
  attempts    Int       @default(1)
  leaseUntil  DateTime  @map("lease_until") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([producer, eventId])
  @@index([status, leaseUntil], map: "event_inbox_status_lease_idx")
  @@index([tenantId, createdAt], map: "event_inbox_tenant_created_idx")
  @@map("event_inbox")
  @@schema("comms")
}
