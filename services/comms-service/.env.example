PORT=4012
NODE_ENV=development

# Primary database (write) — the real target is Supabase-hosted Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/clubspark?schema=comms

# Session-mode connection used ONLY by prisma migrate/introspect.
# Supabase: same credentials, port 5432 (NOT the 6543 transaction pooler, which
# hangs on DDL). Local Postgres: same value as DATABASE_URL.
DIRECT_DATABASE_URL=

# Read replica (optional — falls back to DATABASE_URL)
DATABASE_READ_URL=

# Supabase auth (JWTs are verified against this project's JWKS)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Downstream services
PEOPLE_SERVICE_URL=http://127.0.0.1:4004
VENUE_SERVICE_URL=http://127.0.0.1:4003

# Shared secret authenticating internal service-to-service endpoints
# (POST /events/inbound receives domain events from other services).
# Those routes skip tenant/JWT auth, so this is their ONLY authenticator.
# Shared DEV default so a fresh checkout works; every service must use the SAME
# value. Replace in staging/production with: openssl rand -hex 32
INTERNAL_SECRET=dev-internal-secret-change-in-production

# ─── Delivery providers (all optional locally) ───────────────────────────────
# With none of these set, comms-service logs messages instead of sending them,
# so local development works without any provider account.

# Email — Resend
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# SMS — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Azure Communication Services (target provider — see docs/architecture)
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_SENDER_ADDRESS=
AZURE_COMMUNICATION_PHONE_NUMBER=

# Azure Service Bus (replaces the pilot's HTTP event delivery)
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_TOPICS=

# The region this service instance serves, e.g. eu-west-2.
# Required with no default: a service that does not know its own region cannot
# refuse a tenant whose data must stay elsewhere, and data residency is a legal
# boundary. An unset value stops the service at startup, which is the safe way
# to be wrong.
CLUBSPARK_REGION=eu-west-2
