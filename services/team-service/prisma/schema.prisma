// ClubSpark — Team Service Prisma Schema
// Owns the team schema: teams, team_members, fixtures, availability_responses,
// selections, charge_runs, charges, broadcast_logs

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  // Migrations and introspection need a session-mode connection. Supabase's
  // transaction pooler (port 6543) silently HANGS on DDL; port 5432 works.
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["team"]
}

model Team {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  name               String
  sport              Sport        @default(football)
  season             String?
  ageGroup           String?      @map("age_group")
  gender             String?
  defaultMatchFee    Decimal?     @map("default_match_fee") @db.Decimal(10, 2)
  juniorMatchFee     Decimal?     @map("junior_match_fee") @db.Decimal(10, 2)
  substituteMatchFee Decimal?     @map("substitute_match_fee") @db.Decimal(10, 2)
  chargeRule         String       @default("selected") @map("charge_rule")
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  fixturesUrl        String?      @map("fixtures_url")
  isPublic           Boolean      @default(true) @map("is_public")
  fixtures           Fixture[]
  members            TeamMember[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, sport])
  @@map("teams")
  @@schema("team")
}

model TeamMember {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  teamId        String                 @map("team_id") @db.Uuid
  personId      String?                @map("person_id") @db.Uuid
  displayName   String                 @map("display_name")
  email         String?
  phone         String?
  position      String?
  shirtNumber   Int?                   @map("shirt_number")
  isGuest       Boolean                @default(false) @map("is_guest")
  isJunior      Boolean                @default(false) @map("is_junior")
  dateOfBirth   DateTime?              @map("date_of_birth") @db.Date
  guardianName  String?                @map("guardian_name")
  guardianEmail String?                @map("guardian_email")
  guardianPhone String?                @map("guardian_phone")
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  photoUrl      String?                @map("photo_url")
  role          MemberRole             @default(player)
  availability  AvailabilityResponse[]
  charges       Charge[]
  selections    Selection[]
  team          Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teamId])
  @@index([teamId, isActive])
  @@index([personId])
  @@map("team_members")
  @@schema("team")
}

model Fixture {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  teamId          String                 @map("team_id") @db.Uuid
  opponent        String
  homeAway        HomeAway               @default(home) @map("home_away")
  venue           String?
  kickoffAt       DateTime               @map("kickoff_at") @db.Timestamptz(6)
  meetTime        DateTime?              @map("meet_time") @db.Timestamptz(6)
  durationMinutes Int?                   @map("duration_minutes")
  matchType       String?                @map("match_type")
  status          FixtureStatus          @default(draft)
  notes           String?
  externalRef     String?                @map("external_ref")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  awayScore       Int?                   @map("away_score")
  homeScore       Int?                   @map("home_score")
  availability    AvailabilityResponse[]
  chargeRuns      ChargeRun[]
  team            Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  selections      Selection[]

  @@index([tenantId])
  @@index([teamId])
  @@index([teamId, kickoffAt])
  @@index([teamId, status])
  @@map("fixtures")
  @@schema("team")
}

model AvailabilityResponse {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fixtureId    String             @map("fixture_id") @db.Uuid
  teamMemberId String             @map("team_member_id") @db.Uuid
  response     PlayerAvailability @default(no_response)
  respondedAt  DateTime?          @map("responded_at") @db.Timestamptz(6)
  notes        String?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  fixture      Fixture            @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamMember   TeamMember         @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, teamMemberId])
  @@index([fixtureId])
  @@index([teamMemberId])
  @@map("availability_responses")
  @@schema("team")
}

model Selection {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fixtureId    String        @map("fixture_id") @db.Uuid
  teamMemberId String        @map("team_member_id") @db.Uuid
  role         SelectionRole @default(starter)
  position     String?
  shirtNumber  Int?          @map("shirt_number")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  fixture      Fixture       @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamMember   TeamMember    @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, teamMemberId])
  @@index([fixtureId])
  @@index([teamMemberId])
  @@map("selections")
  @@schema("team")
}

model ChargeRun {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  fixtureId   String          @map("fixture_id") @db.Uuid
  initiatedBy String?         @map("initiated_by") @db.Uuid
  status      ChargeRunStatus @default(draft)
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderId     String?         @map("order_id") @db.Uuid
  fixture     Fixture         @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  charges     Charge[]

  @@index([fixtureId])
  @@index([tenantId])
  @@map("charge_runs")
  @@schema("team")
}

model Charge {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chargeRunId  String       @map("charge_run_id") @db.Uuid
  teamMemberId String       @map("team_member_id") @db.Uuid
  amount       Decimal      @db.Decimal(10, 2)
  status       ChargeStatus @default(pending)
  paidAt       DateTime?    @map("paid_at") @db.Timestamptz(6)
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  paymentId    String?      @map("payment_id")
  chargeRun    ChargeRun    @relation(fields: [chargeRunId], references: [id], onDelete: Cascade)
  teamMember   TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@index([chargeRunId])
  @@index([teamMemberId])
  @@index([status])
  @@map("charges")
  @@schema("team")
}

enum Sport {
  football
  cricket
  other

  @@schema("team")
}

enum FixtureStatus {
  draft
  scheduled
  squad_selected
  fees_requested
  completed
  cancelled

  @@schema("team")
}

enum HomeAway {
  home
  away
  neutral

  @@schema("team")
}

enum PlayerAvailability {
  available
  maybe
  unavailable
  no_response

  @@schema("team")
}

enum SelectionRole {
  starter
  substitute
  reserve

  @@schema("team")
}

enum ChargeRunStatus {
  draft
  sent
  completed
  cancelled

  @@schema("team")
}

enum ChargeStatus {
  pending
  paid
  waived

  @@schema("team")
}

enum MemberRole {
  player
  coach
  manager

  @@schema("team")
}
