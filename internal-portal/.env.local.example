# ClubSpark Internal Staff Portal — local config
#
#   cp .env.local.example .env.local
#
# This portal is staff-only and drives the cross-tenant admin plane: staff
# impersonation, per-tenant feature flags, account administration and the audit
# trail. Treat these values accordingly.
#
# NOTE: unlike the 15 services, this portal is not yet generated by
# `npm run setup:env`. INTERNAL_SECRET must be copied by hand from the
# repository-root .env and kept in step with it.

# Must be byte-identical to the services' INTERNAL_SECRET (repo-root .env).
# There is deliberately no default: admin-service's guard is fail-closed, so a
# mismatch produces a silent 401 on every internal call rather than a useful
# error. Missing entirely now throws with an explanation.
INTERNAL_SECRET=

# admin-service base URL. Defaults to the canonical local port when unset.
ADMIN_SERVICE_URL=http://127.0.0.1:4006

# Supabase auth for staff sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
