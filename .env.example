# ClubSpark platform — ONE file to configure local development.
#
#   cp .env.example .env      # fill in the real values below
#   npm run setup:env         # generates all 15 services/<name>/.env
#   npm run check:env         # verifies they are present and current
#
# Every service talks to the same database and the same Supabase project, so
# those values live here once. Per-service values that must differ (ports, peer
# service URLs) are derived — you do not set them by hand. The generated files
# are git-ignored, as is this one once you copy it.
#
# If a single service genuinely needs a different value, put it in
# services/<name>/.env.override rather than editing the generated .env.

# ── Required ─────────────────────────────────────────────────────────────────

# Supabase-hosted Postgres. Use the TRANSACTION pooler (port 6543) and leave the
# query string off — each service's PrismaService appends
# `pgbouncer=true&connection_limit=…&pool_timeout=10` itself. Both flags matter:
# without pgbouncer=true Prisma issues prepared statements a transaction pooler
# cannot support, and without a connection limit 15 services exhaust the pool.
#
# Any `?` or `#` in the password must be percent-encoded (%3F / %23) — setup:env
# refuses to generate otherwise rather than emit a corrupted URL.
#
# Do NOT set DIRECT_DATABASE_URL. Nothing at runtime reads it, and the migration
# scripts derive it themselves (session port 5432, plus the ?schema= pin each
# service needs to find its own _prisma_migrations). Run `npm run migrate:all`.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://<project-ref>.supabase.co

# Shared secret authenticating service-to-service calls. MUST be identical
# across every service and the internal portal, or internal routes fail closed.
# Generate one with: openssl rand -hex 32
INTERNAL_SECRET=<random-hex>

# ── Optional ─────────────────────────────────────────────────────────────────

# Bypasses row-level security. Handed only to the services on the allowlist in
# scripts/setup-env.mjs (currently venue-service, its only consumer) — not
# sprayed to all 15.
SUPABASE_SERVICE_ROLE_KEY=

# ── Per-service keys ─────────────────────────────────────────────────────────
# Consumed by one service each; setup:env routes them to the right place.

# integration-service. All three fall back to a COMMITTED dev default when
# unset, so leaving them blank is silently insecure rather than a startup
# failure — `npm run check:env` warns when that is the case.
API_KEY_HASH_SECRET=
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# comms-service delivery providers.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_SENDER_ADDRESS=
AZURE_COMMUNICATION_PHONE_NUMBER=
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_TOPICS=

# Validates incoming Supabase JWTs.
SUPABASE_JWT_SECRET=

# Region this instance serves. Required in production; defaults to eu-west-2
# under development/test. A service that cannot determine its region refuses to
# start, because it cannot then tell whether it may serve a given tenant.
CLUBSPARK_REGION=eu-west-2

# Prisma pool size per service. Default 1, which is what the platform has always
# run at. Applied once, by each service's PrismaService — this script leaves
# DATABASE_URL clean precisely so the flags have a single owner.
#
# 1 is Prisma's serverless recommendation and is conservative for long-running
# services sharing one pooler; raising it may help throughput, but change it
# deliberately and re-run the service suites, because 15 services multiply it.
DB_CONNECTION_LIMIT=1

# Read replica. Falls back to DATABASE_URL when unset.
DATABASE_READ_URL=

REDIS_URL=

# For AI features. Use the ClubSpark API organisation key, not a personal one —
# see docs/engineering/ai-provider-operations.md.
ANTHROPIC_API_KEY=

NODE_ENV=development
